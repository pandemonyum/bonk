// Catalogo dei suoni (progetto docs/design/AUDIO_SYSTEM.md § 7). Schema in src/audio/catalog.rs
// (gameplay-engineer), valori del proprietario degli asset audio (pixel-art-director, D-070).
// Incorporato nel binario e validato da un test: un errore qui ferma ./scripts/check.ps1.
//
// AUDIO-1: valori di partenza del § 3.4 e § 3.5. AUDIO-2: i due cue delle Opzioni, sintetizzati
// da assets-src/audio/sfx/ui_*.json con scripts/audio_sfx.py (docs/audio/AUDIO_BIBLE.md). Senza
// variazione di guadagno né di altezza: la tacca è l'anteprima del volume, deve suonare uguale.
// AUDIO-3: la sezione music con la traccia della home (MUSIC-HOME-001 v1, D-071), le dissolvenze
// e quella del fuoco della finestra.
//
// Un cue è un one-shot del bus Sfx (gioco) o Ui (interfaccia), con file .wav relativi ad assets/;
// la musica ha la sua sezione in fondo, gli stinger l'avranno (AUDIO-3b); niente ambienti
// (D-071). cooldown_ms è un intervallo medio (a credito, vedi src/audio/mixer/start.rs):
//   "shot.ember": (
//       bus: Sfx, files: ["audio/sfx/companions/ember_shot_1.wav"], gain: 0.45,
//       // facoltativi, con il loro default:
//       gain_jitter_db: 1.5, pitch: (0.95, 1.05), priority: Normal, cooldown_ms: 0,
//       max_instances: 1, on_limit: Drop, coalesce: Single, cull: Always, length_s: 2.0,
//   ),
(
    version: 1,
    voices: (
        max: 24,
        max_web: 16,
        reserved_critical: 3,
        starts_per_frame: 6,
        starts_per_frame_web: 4,
        sfx_headroom: 3.0,
    ),
    trims: (music: 0.8, sfx: 0.8, ambience: 0.7, ui: 0.6),
    cues: {
        // tacca del volume (file di 37,9 ms)
        "ui.tick": (
            bus: Ui, files: ["audio/sfx/ui/tick.wav"], gain: 0.55,
            gain_jitter_db: 0.0, pitch: (1.0, 1.0), priority: High, cooldown_ms: 40,
            max_instances: 2, length_s: 0.05,
        ),
        // interruttore Sì/No (file di 108,8 ms)
        "ui.toggle": (
            bus: Ui, files: ["audio/sfx/ui/toggle.wav"], gain: 0.6,
            gain_jitter_db: 0.0, pitch: (1.0, 1.0), priority: High, cooldown_ms: 40,
            max_instances: 2, length_s: 0.12,
        ),
    },
    fallbacks: {},
    // Musica (progetto § 3.7): tracce Ogg Vorbis in loop sul bus Music, con file relativi ad
    // assets/ e un guadagno in (0, 1] sotto trims.music. Il menu suona "home" in ogni schermata;
    // in partita la traccia dello stage (run_by_stage: { "meadow": "run_meadow" }, altrimenti
    // run_default: Some("run_meadow")). Una traccia che manca è silenzio: oggi la partita e i
    // risultati (orda, boss, risultati e stinger con AUDIO-3b).
    music: (
        tracks: {
            // loop di 72 s (3 175 200 campioni), 80 bpm, picco sotto -1 dBFS
            "home": (file: "audio/music/home.ogg", gain: 0.8),
        },
        run_by_stage: {},
        // secondi di tempo reale (0 è un cambio secco): verso la partita, anche quando la
        // partita è silenzio; verso il menu; focus: finestra non attiva, vale per tutto l'audio
        // (§ 3.11), anche per gli effetti
        fades: (to_run: 1.5, to_home: 1.5, focus: 0.25),
    ),
)
