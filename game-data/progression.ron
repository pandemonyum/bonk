// Progressione della run: esperienza, gemme, draft delle carte.
(
    version: 6,
    // XP per passare dal livello n al n+1 = base + per_level × (n − 1): 5, 8, 11, 14, ...
    // Obiettivo GDD: primo level-up entro 30-45 s.
    xp_to_level: (base: 5.0, per_level: 3.0),
    gem: (
        sprite: "sprites/xp_gem.png",
        // più veloce del player anche con tutti gli upgrade di velocità
        magnet_speed: 220.0,
        collect_distance: 6.0,
        // oltre, l'XP di una gemma nuova si somma a una già a terra (niente migliaia di entità)
        max_on_field: 300,
    ),
    // monete: cadono da alcuni nemici (enemies.ron: coins), si raccolgono con la calamita delle
    // gemme e aprono i forzieri (stages.ron: chests)
    coin: (
        sprite: "sprites/coin.png",
        // oltre, il valore di una moneta nuova va alla più vicina già a terra
        max_on_field: 100,
        // cadono sparse a questa distanza dalla gemma
        scatter: 6.0,
    ),
    // esperienza dei compagni a fine run (si salva sul dispositivo): un punto ogni 15 s in
    // squadra, uno ogni 40 nemici finiti, 20 per la vittoria (~85-90 a run); per salire dal
    // livello n al n+1 servono 20 + 3 × (n − 1): un punto talento per livello, 48 per compagno
    // (livello 49); ~3 punti dopo la prima run, metà albero in ~15 run, tutto in ~50
    companion_xp: (
        seconds_per_point: 15.0,
        kills_per_point: 40,
        victory: 20,
        first_level: 20,
        per_level: 3,
        max_level: 49,
    ),
    draft_size: 3,
    // peso relativo di estrazione nel draft
    rarity_weights: (common: 10.0, uncommon: 5.0, rare: 2.0),
    // si parte con un compagno solo; a questi livelli il draft propone soltanto chi può unirsi
    // alla squadra (negli altri draft non escono carte "nuovo compagno"): uno per posto libero
    companion_levels: [3, 9],
)
