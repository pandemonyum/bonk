// Upgrade proposti nel draft a ogni livello. Le percentuali si sommano tra stack sul valore
// base dei dati (2 stack di +15% = +30%). Gli effetti "Companion" valgono per tutti i compagni.
// Nomi e testi sono originali e provvisori. Nei testi delle carte solo caratteri ASCII (niente
// lettere accentate): il font provvisorio non le ha (vedi D-013, la validazione lo controlla).
(
    version: 3,
    upgrades: [
        (
            id: "ember_damage",
            name: "Fiamma viva",
            description: "Danno dei compagni +15%",
            rarity: Common,
            max_stack: 5,
            requires: [],
            effect: CompanionDamagePct(15.0),
        ),
        (
            id: "ember_rate",
            name: "Respiro rapido",
            description: "Intervallo tra gli attacchi dei compagni -10%",
            rarity: Common,
            max_stack: 5,
            requires: [],
            effect: CompanionIntervalPct(-10.0),
        ),
        (
            id: "ember_multishot",
            name: "Scintille gemelle",
            description: "+1 proiettile per attacco, a ventaglio",
            rarity: Rare,
            max_stack: 3,
            // prima un po' di potenza, poi la quantità
            requires: ["ember_damage"],
            effect: CompanionProjectiles(1),
        ),
        (
            id: "ember_pierce",
            name: "Fuoco perforante",
            description: "Perforazione +1: ogni proiettile passa un nemico",
            rarity: Uncommon,
            max_stack: 3,
            requires: [],
            effect: CompanionPierce(1),
        ),
        (
            id: "ember_range",
            name: "Vista lunga",
            description: "Gittata dei compagni +20%",
            rarity: Common,
            max_stack: 3,
            requires: [],
            effect: CompanionRangePct(20.0),
        ),
        (
            id: "ember_speed",
            name: "Vampa veloce",
            description: "Volo dei proiettili +20%",
            rarity: Common,
            max_stack: 2,
            requires: [],
            effect: ProjectileSpeedPct(20.0),
        ),
        (
            id: "vitality",
            name: "Scorza robusta",
            description: "HP massimi +20 (e cura 20)",
            rarity: Common,
            max_stack: 5,
            requires: [],
            effect: MaxHp(20.0),
        ),
        (
            id: "regen",
            name: "Germoglio",
            description: "Rigenera 0,5 HP al secondo",
            rarity: Uncommon,
            max_stack: 3,
            requires: [],
            effect: RegenPerSecond(0.5),
        ),
        (
            id: "swift",
            name: "Passo leggero",
            description: "Movimento +10%",
            rarity: Uncommon,
            max_stack: 3,
            requires: [],
            effect: MoveSpeedPct(10.0),
        ),
        (
            id: "magnet",
            name: "Richiamo",
            description: "Raggio di raccolta delle gemme +25%",
            rarity: Common,
            max_stack: 3,
            requires: [],
            effect: PickupRadiusPct(25.0),
        ),
        (
            id: "snack",
            name: "Merenda",
            description: "Cura 30 HP",
            rarity: Common,
            // sempre disponibile: il draft non resta mai vuoto
            max_stack: 99,
            requires: [],
            effect: Heal(30.0),
        ),
    ],
)
