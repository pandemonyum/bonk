// Upgrade proposti nel draft a ogni livello. Le percentuali si sommano tra stack sul valore
// base dei dati (2 stack di +15% = +30%). Gli effetti "Companion" valgono per tutti i compagni.
// Nomi e testi sono originali e provvisori. Lettere accentate e segni come « » – … × vanno
// bene: i font dell'interfaccia li disegnano (D-044); la validazione rifiuta il resto.
(
    version: 6,
    upgrades: [
        (
            id: "ember_damage",
            name: "Fiamma viva",
            description: "Danno dei compagni +15%",
            rarity: Common,
            max_stack: 5,
            requires: [],
            effect: CompanionDamagePct(15.0),
        ),
        (
            id: "ember_rate",
            name: "Respiro rapido",
            description: "Intervallo tra gli attacchi dei compagni -10%",
            rarity: Common,
            max_stack: 5,
            requires: [],
            effect: CompanionIntervalPct(-10.0),
        ),
        (
            id: "ember_multishot",
            name: "Scintille gemelle",
            description: "+1 proiettile per raffica, +1 foglia in orbita o +1 salto del fulmine",
            rarity: Rare,
            max_stack: 3,
            // prima un po' di potenza, poi la quantità
            requires: ["ember_damage"],
            effect: CompanionProjectiles(1),
        ),
        (
            id: "ember_pierce",
            name: "Fuoco perforante",
            description: "Perforazione +1: ogni proiettile passa un nemico",
            rarity: Uncommon,
            max_stack: 3,
            requires: [],
            effect: CompanionPierce(1),
        ),
        (
            id: "ember_range",
            name: "Vista lunga",
            description: "Gittata, area dell'onda e raggio delle foglie +20%",
            rarity: Common,
            max_stack: 3,
            requires: [],
            effect: CompanionRangePct(20.0),
        ),
        (
            id: "ember_speed",
            name: "Vampa veloce",
            description: "Velocità dei proiettili +20%",
            rarity: Common,
            max_stack: 2,
            requires: [],
            effect: ProjectileSpeedPct(20.0),
        ),
        (
            id: "vitality",
            name: "Scorza robusta",
            description: "HP massimi +20 (e cura 20)",
            rarity: Common,
            max_stack: 5,
            requires: [],
            effect: MaxHp(20.0),
        ),
        (
            id: "regen",
            name: "Germoglio",
            // P0.7: da 0,5. Con 3 stack erano 90 HP al minuto, quasi tutti i danni di una run
            description: "Rigenera 0,3 HP al secondo",
            rarity: Uncommon,
            max_stack: 3,
            requires: [],
            effect: RegenPerSecond(0.3),
        ),
        (
            id: "swift",
            name: "Passo leggero",
            description: "Velocità di movimento +10%",
            rarity: Uncommon,
            max_stack: 3,
            requires: [],
            effect: MoveSpeedPct(10.0),
        ),
        (
            id: "magnet",
            name: "Richiamo",
            description: "Raggio di raccolta delle gemme +25%",
            rarity: Common,
            max_stack: 3,
            requires: [],
            effect: PickupRadiusPct(25.0),
        ),
        (
            id: "join_ember",
            name: "Nuovo compagno: Fiammetto",
            description: "Fiammetto si unisce: palle di fuoco sul nemico vicino",
            // comune: la squadra arriva nei primi livelli, prima delle orde del secondo minuto
            rarity: Common,
            // per chi ha scelto un altro compagno iniziale nel menu
            max_stack: 1,
            requires: [],
            effect: JoinCompanion("ember"),
        ),
        (
            id: "join_tide",
            name: "Nuovo compagno: Ondino",
            description: "Ondino si unisce: onda d'acqua attorno a te che ferisce e rallenta",
            rarity: Common,
            // una sola volta; proposta solo se c'è un posto libero (player.ron)
            max_stack: 1,
            requires: [],
            effect: JoinCompanion("tide"),
        ),
        (
            id: "join_sprout",
            name: "Nuovo compagno: Foglin",
            description: "Foglin si unisce: foglie che ti girano attorno e tagliano",
            rarity: Common,
            max_stack: 1,
            requires: [],
            effect: JoinCompanion("sprout"),
        ),
        (
            id: "join_spark",
            name: "Nuovo compagno: Tuonny",
            description: "Tuonny si unisce: un fulmine che salta da un nemico all'altro",
            rarity: Common,
            max_stack: 1,
            requires: [],
            effect: JoinCompanion("spark"),
        ),
        (
            id: "snack",
            name: "Merenda",
            description: "Cura 30 HP",
            rarity: Common,
            // sempre disponibile: il draft non resta mai vuoto
            max_stack: 99,
            requires: [],
            effect: Heal(30.0),
        ),
        // Reliquie: solo nei forzieri (mai nel draft), una volta per run, molto più forti delle
        // carte; il forziere ne propone 3 a caso tra quelle non ancora prese
        (
            id: "relic_courage",
            name: "Pietra del coraggio",
            description: "Danno dei compagni +50%",
            rarity: Relic,
            max_stack: 1,
            requires: [],
            effect: CompanionDamagePct(50.0),
        ),
        (
            id: "relic_hourglass",
            name: "Clessidra svelta",
            // non di più: con 5 Respiro rapido l'onda di Ondino durerebbe più del suo intervallo
            description: "Attacchi dei compagni\npiù frequenti del 12%",
            rarity: Relic,
            max_stack: 1,
            requires: [],
            effect: CompanionIntervalPct(-12.0),
        ),
        (
            id: "relic_nest",
            name: "Nido di scintille",
            description: "+2 palle di fuoco,\nfoglie o salti del fulmine",
            rarity: Relic,
            max_stack: 1,
            requires: [],
            effect: CompanionProjectiles(2),
        ),
        (
            id: "relic_spyglass",
            name: "Cannocchiale di corteccia",
            description: "Gittata, onda e orbita +40%",
            rarity: Relic,
            max_stack: 1,
            requires: [],
            effect: CompanionRangePct(40.0),
        ),
        (
            id: "relic_oak",
            name: "Cuore di quercia",
            description: "HP massimi +50 (e cura 50)",
            rarity: Relic,
            max_stack: 1,
            requires: [],
            effect: MaxHp(50.0),
        ),
        (
            id: "relic_dew",
            name: "Rugiada perenne",
            description: "Rigeneri 0,6 HP al secondo",
            rarity: Relic,
            max_stack: 1,
            requires: [],
            effect: RegenPerSecond(0.6),
        ),
        (
            id: "relic_sandals",
            name: "Sandali di vento",
            description: "Velocità di movimento +20%",
            rarity: Relic,
            max_stack: 1,
            requires: [],
            effect: MoveSpeedPct(20.0),
        ),
        (
            id: "relic_piggy",
            name: "Salvadanaio di coccio",
            description: "Ogni moneta raccolta\nvale doppio",
            rarity: Relic,
            max_stack: 1,
            requires: [],
            effect: CoinGainPct(100.0),
        ),
        // finite le altre reliquie, il forziere cura
        (
            id: "relic_feast",
            name: "Banchetto del bosco",
            description: "Cura 50 HP",
            rarity: Relic,
            max_stack: 99,
            requires: [],
            effect: Heal(50.0),
        ),
    ],
)
