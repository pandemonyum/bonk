// Biomi e stage (mappe). Lo stage giocato è il primo, o quello scelto con `--stage <id>`.
// D-068: un bioma è l'aspetto della mappa in tre livelli (terreno, decorazioni calpestabili,
// ostacoli con collisione) e si sceglie per id; quanti ostacoli e la zona libera sono dello
// stage. I tile si nominano come nel manifest (assets/manifest.json, campo `tiles`).
(
    version: 7,
    biomes: [
        (
            id: "meadow",
            terrain: (
                tileset: "tiles/meadow_tileset.png",
                tiles: [
                    "grass_a", "grass_b", "grass_tuft", "flowers_white", "flowers_pink", "dirt",
                    "hedge", "grass_c", "grass_clover", "flowers_yellow", "grass_pebbles",
                    "grass_tall",
                ],
                // in coda 15 bordi ciascuno: dirt_n, dirt_e, dirt_ne, ... hedge_nesw
                edges: ["dirt", "hedge"],
                ground: [
                    ("grass_a", 0.42), ("grass_b", 0.42), ("grass_tuft", 0.09),
                    ("flowers_white", 0.04), ("flowers_pink", 0.03),
                ],
                // radure di terra a macchie: con 0.74 coprivano il 15% dell'arena, 0.80 le
                // riduce a macchie
                patch: Some((tile: "dirt", cell: 10, threshold: 0.80)),
                border: "hedge",
                variants: [
                    ("grass_a", "grass_c", 0.30), ("grass_a", "grass_clover", 0.42),
                    ("grass_a", "grass_pebbles", 0.50), ("grass_b", "grass_tall", 0.14),
                    ("flowers_white", "flowers_yellow", 0.3), ("flowers_pink", "flowers_yellow", 0.3),
                ],
                // fiori a ciuffi sparsi: con 0.72 e 0.4 le macchie coprivano mezzo schermo
                clusters: Some((
                    tiles: ["flowers_white", "flowers_pink", "flowers_yellow"],
                    cell: 6,
                    threshold: 0.76,
                    share: 0.3,
                )),
            ),
            // sull'erba alberi (60%) e rocce, sulle radure di terra solo rocce
            obstacles: [
                (id: "tree", sprite: "sprites/tree.png", footprint_radius: 4.0, ground: 0.6),
                (id: "rock", sprite: "sprites/rock.png", footprint_radius: 7.0, ground: 0.4, patch: 1.0),
            ],
        ),
        (
            id: "forest",
            terrain: (
                tileset: "tiles/forest_tileset.png",
                tiles: [
                    "moss_a", "moss_b", "moss_leaves", "moss_roots", "clearing", "thicket",
                    "moss_c", "moss_twigs", "clearing_b", "leaves_a", "leaves_b",
                ],
                edges: ["clearing", "thicket"],
                ground: [("moss_a", 0.40), ("moss_b", 0.40), ("moss_leaves", 0.12), ("moss_roots", 0.08)],
                // radure al sole più larghe delle macchie di terra della prateria
                patch: Some((tile: "clearing", cell: 12, threshold: 0.76)),
                border: "thicket",
                variants: [
                    ("moss_a", "moss_c", 0.18), ("moss_b", "moss_twigs", 0.12),
                    ("clearing", "clearing_b", 0.25),
                ],
                // tappeti di foglie cadute a macchie
                clusters: Some((tiles: ["leaves_a", "leaves_b"], cell: 6, threshold: 0.8, share: 0.3)),
            ),
            decorations: Some((
                tileset: "tiles/forest_decor.png",
                tiles: [
                    "fern", "mushrooms_tan", "mushrooms_white", "stones_moss", "ruin_slab",
                    "ruin_rubble", "twigs", "flowers_shade",
                ],
                rules: [
                    // piccole rovine: lastre e macerie a gruppi, nel bosco e nelle radure
                    (tiles: ["ruin_slab", "ruin_slab", "ruin_rubble"], on: Any, density: 0.4, cluster: Some((9, 0.84))),
                    // funghi a gruppi nel sottobosco
                    (tiles: ["mushrooms_tan", "mushrooms_white"], on: Ground, density: 0.25, cluster: Some((6, 0.78))),
                    // fiorellini d'ombra nelle radure
                    (tiles: ["flowers_shade"], on: Patch, density: 0.08),
                    // felci, sassi e rametti sparsi
                    (tiles: ["fern", "fern", "stones_moss", "twigs"], on: Ground, density: 0.05),
                ],
            )),
            // alberi nel bosco; ceppi, rocce e colonne spezzate anche nelle radure
            obstacles: [
                (id: "forest_tree", sprite: "sprites/forest_tree.png", footprint_radius: 4.0, ground: 0.55),
                (id: "stump", sprite: "sprites/stump.png", footprint_radius: 6.0, ground: 0.12, patch: 0.3),
                (id: "log", sprite: "sprites/log.png", footprint_radius: 7.0, ground: 0.13, patch: 0.1),
                (id: "rock", sprite: "sprites/rock.png", footprint_radius: 7.0, ground: 0.1, patch: 0.2),
                (id: "ruin_pillar", sprite: "sprites/ruin_pillar.png", footprint_radius: 6.0, ground: 0.1, patch: 0.4),
            ],
        ),
    ],
    stages: [
        (
            id: "meadow",
            display_name: "Prateria dei Germogli",
            biome: "meadow",
            starting_companion: "ember",
            spawns: (
                // anello (min, max) in px attorno al player; i punti in vista vengono scartati.
                // La vista che può essere a schermo arriva a 640×360 (mezza diagonale ~367 px,
                // D-062): era (290, 360) quando lo schermo era sempre 480×270; con (300, 420) i
                // nemici arrivavano più tardi e la sonda vinceva il 94%
                ring: (260.0, 400.0),
                // obiettivo di prestazioni P0: 200 nemici a 60 FPS
                max_alive: 220,
                // gelatine all'avvio, per non partire da un campo vuoto
                initial_burst: 5,
                waves: [
                    // ritmo = rate_per_min + rate_growth_per_min × minuti da start_s
                    (enemy: "blob", start_s: 0.0, rate_per_min: 24.0, rate_growth_per_min: 12.0, max_alive: 90),
                    // lo sciame (veloce quasi come il player) arriva dopo il secondo compagno (livello 3)
                    (enemy: "swarm", start_s: 120.0, rate_per_min: 16.0, rate_growth_per_min: 15.0, max_alive: 110),
                    (enemy: "armored", start_s: 150.0, rate_per_min: 4.0, rate_growth_per_min: 2.0, max_alive: 25),
                ],
            ),
            run: (
                // 15 minuti di ondate con un'orda a 5:00 e a 10:00, poi le ondate si fermano e
                // arriva il boss
                duration_s: 900.0,
                // nemici di ondate, orde ed élite: +14% HP e +9% danno per minuto (a 15:00 ×3,1 e
                // ×2,35; con 10 minuti erano +15% e +12%)
                hp_growth_per_min: 0.14,
                damage_growth_per_min: 0.09,
                // una gelatina gigante a 2:30, poi ogni 75 s (circa 10 a run)
                elites: (enemy: "elite_blob", first_s: 150.0, every_s: 75.0),
                hordes: (
                    // l'annuncio compare 4 s prima; ogni orda nasce in 8 s tutta attorno a te
                    warning_s: 4.0,
                    duration_s: 8.0,
                    // vivi al massimo durante un'orda, ondate comprese (fuori orda 220)
                    max_alive: 320,
                    list: [
                        (at_s: 300.0, groups: [(enemy: "swarm", count: 75), (enemy: "blob", count: 45)]),
                        (at_s: 600.0, groups: [(enemy: "swarm", count: 90), (enemy: "blob", count: 60), (enemy: "armored", count: 15)]),
                    ],
                ),
                boss: "boss_king",
            ),
            // forzieri lontani dal player: si aprono passandoci sopra con le monete e danno una
            // reliquia a scelta su tre (upgrades.ron, rarità Relic)
            chests: (
                sprite: "sprites/chest_sheet.png",
                frame_w: 24,
                frame_h: 22,
                // due mete alla volta; aperto uno, ne nasce subito un altro
                on_map: 2,
                // 8-13 s di cammino, sempre fuori vista; senza posto la fascia di riserva
                distance: (600.0, 1000.0),
                fallback_distance: (400.0, 1400.0),
                min_from_edge: 160.0,
                min_apart: 600.0,
                // chi è stato spinto lontano (~24 s di cammino) non resta senza meta
                respawn_beyond: 1800.0,
                open_radius: 16.0,
                // 10, 15, 20, ...: circa un forziere ogni 2 minuti per chi ci va
                price_base: 10,
                price_per_open: 5,
            ),
            obstacles: (
                // ~650 tra rocce e alberi su 256x256 tile (mai adiacenti: varchi sempre aperti)
                density: 0.012,
                // nessun ostacolo entro 8 tile dal punto di partenza
                safe_radius: 128.0,
            ),
        ),
        (
            id: "forest",
            display_name: "Bosco Ombroso",
            biome: "forest",
            starting_companion: "ember",
            // D-068, primo incremento: stessi nemici, arco della run e forzieri della prateria;
            // il bosco cambia mappa e ostacoli. Gruppi di nemici propri in seguito.
            spawns: (
                ring: (260.0, 400.0),
                max_alive: 220,
                initial_burst: 5,
                waves: [
                    (enemy: "blob", start_s: 0.0, rate_per_min: 24.0, rate_growth_per_min: 12.0, max_alive: 90),
                    (enemy: "swarm", start_s: 120.0, rate_per_min: 16.0, rate_growth_per_min: 15.0, max_alive: 110),
                    (enemy: "armored", start_s: 150.0, rate_per_min: 4.0, rate_growth_per_min: 2.0, max_alive: 25),
                ],
            ),
            run: (
                duration_s: 900.0,
                hp_growth_per_min: 0.14,
                damage_growth_per_min: 0.09,
                elites: (enemy: "elite_blob", first_s: 150.0, every_s: 75.0),
                hordes: (
                    warning_s: 4.0,
                    duration_s: 8.0,
                    max_alive: 320,
                    list: [
                        (at_s: 300.0, groups: [(enemy: "swarm", count: 75), (enemy: "blob", count: 45)]),
                        (at_s: 600.0, groups: [(enemy: "swarm", count: 90), (enemy: "blob", count: 60), (enemy: "armored", count: 15)]),
                    ],
                ),
                boss: "boss_king",
            ),
            chests: (
                sprite: "sprites/chest_sheet.png",
                frame_w: 24,
                frame_h: 22,
                on_map: 2,
                distance: (600.0, 1000.0),
                fallback_distance: (400.0, 1400.0),
                min_from_edge: 160.0,
                min_apart: 600.0,
                respawn_beyond: 1800.0,
                open_radius: 16.0,
                price_base: 10,
                price_per_open: 5,
            ),
            obstacles: (
                // un bosco: un terzo di ostacoli in più della prateria (~900), con gli stessi
                // varchi garantiti
                density: 0.016,
                safe_radius: 128.0,
            ),
        ),
    ],
)
