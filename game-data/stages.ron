// Stage (mappe). La prima voce è quella giocata.
(
    version: 5,
    stages: [
        (
            id: "meadow",
            display_name: "Prateria dei Germogli",
            starting_companion: "ember",
            spawns: (
                // anello (min, max) in px attorno al player; i punti in vista vengono scartati
                // (mezza diagonale dello schermo ~275 px)
                ring: (290.0, 360.0),
                // obiettivo di prestazioni P0: 200 nemici a 60 FPS
                max_alive: 220,
                // gelatine all'avvio, per non partire da un campo vuoto
                initial_burst: 5,
                waves: [
                    // ritmo = rate_per_min + rate_growth_per_min × minuti da start_s
                    (enemy: "blob", start_s: 0.0, rate_per_min: 24.0, rate_growth_per_min: 12.0, max_alive: 90),
                    // lo sciame (veloce quasi come il player) arriva quando la squadra ha di solito un secondo compagno
                    (enemy: "swarm", start_s: 100.0, rate_per_min: 16.0, rate_growth_per_min: 15.0, max_alive: 110),
                    (enemy: "armored", start_s: 150.0, rate_per_min: 4.0, rate_growth_per_min: 2.0, max_alive: 25),
                ],
            ),
            run: (
                // 10 minuti di orde, poi le ondate si fermano e arriva il boss
                duration_s: 600.0,
                // nemici di ondate ed élite: +15% HP e +8% danno per minuto (a 10:00 ×2,5 e ×1,8)
                hp_growth_per_min: 0.15,
                damage_growth_per_min: 0.08,
                // una gelatina gigante a 2:30, poi ogni 75 s (circa 6 a run)
                elites: (enemy: "elite_blob", first_s: 150.0, every_s: 75.0),
                boss: "boss_king",
            ),
            obstacles: (
                // ~650 tra rocce e alberi su 256x256 tile (mai adiacenti: varchi sempre aperti)
                density: 0.012,
                // nessun ostacolo entro 8 tile dal punto di partenza
                safe_radius: 128.0,
                // sull'erba; sulle radure di terra solo rocce
                tree_chance: 0.6,
            ),
        ),
    ],
)
