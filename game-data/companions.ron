// Compagni mostriciattolo. `attack` rimanda a un id di attacks.ron.
// display_name: nomi scelti dall'utente (D-052); da verificare come marchi prima di pubblicare.
// `frame`: foglio animato 4×5 (fermo, cammino di profilo, attacco, in su, in giù), disegni
// forniti dall'utente. La distanza di inseguimento segue i corpi del foglio (~30 di larghezza).
// Il compagno iniziale è in stages.ron; gli altri arrivano con le carte JoinCompanion di
// upgrades.ron, nei posti liberi di player.ron (companion_slots).
(
    version: 5,
    companions: [
        (
            id: "ember",
            display_name: "Fiammetto",
            element: Fire,
            sprite: "sprites/ember_sheet.png",
            frame: Some((w: 40, h: 36)),
            attack: "ember_bolt",
            follow: (
                // px dietro al player quando si ferma (da 18 con gli sprite piccoli)
                distance: 26.0,
                // px/s, più del player (anche con tutti gli upgrade) per recuperare
                max_speed: 120.0,
                // frazione della distanza recuperata al secondo
                gain: 6.0,
            ),
        ),
        (
            id: "tide",
            display_name: "Ondino",
            element: Water,
            sprite: "sprites/tide_sheet.png",
            frame: Some((w: 40, h: 36)),
            attack: "tide_pulse",
            follow: (distance: 30.0, max_speed: 120.0, gain: 5.0),
        ),
        (
            id: "sprout",
            display_name: "Foglin",
            element: Nature,
            sprite: "sprites/sprout_sheet.png",
            frame: Some((w: 40, h: 36)),
            attack: "leaf_orbit",
            follow: (distance: 30.0, max_speed: 120.0, gain: 5.0),
        ),
        (
            id: "spark",
            display_name: "Tuonny",
            element: Electric,
            sprite: "sprites/spark_sheet.png",
            frame: Some((w: 40, h: 36)),
            attack: "spark_chain",
            follow: (distance: 30.0, max_speed: 120.0, gain: 5.0),
        ),
    ],
)
