// Compagni mostriciattolo. `attack` rimanda a un id di attacks.ron.
// display_name è un nome di lavorazione: i nomi definitivi vanno verificati (marchi).
// Il compagno iniziale è in stages.ron; gli altri arrivano con le carte JoinCompanion di
// upgrades.ron, nei posti liberi di player.ron (companion_slots).
(
    version: 4,
    companions: [
        (
            id: "ember",
            display_name: "Brasa",
            element: Fire,
            sprite: "sprites/ember_companion.png",
            attack: "ember_bolt",
            follow: (
                // px dietro al player quando si ferma
                distance: 18.0,
                // px/s, più del player (anche con tutti gli upgrade) per recuperare
                max_speed: 120.0,
                // frazione della distanza recuperata al secondo
                gain: 6.0,
            ),
        ),
        (
            id: "tide",
            display_name: "Gocci",
            element: Water,
            sprite: "sprites/tide_companion.png",
            attack: "tide_pulse",
            follow: (distance: 22.0, max_speed: 120.0, gain: 5.0),
        ),
        (
            id: "sprout",
            display_name: "Frond",
            element: Nature,
            sprite: "sprites/sprout_companion.png",
            attack: "leaf_orbit",
            follow: (distance: 22.0, max_speed: 120.0, gain: 5.0),
        ),
    ],
)
