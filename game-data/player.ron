// Evocatore controllato dal giocatore. Unità: pixel di mondo (1 px = 1 texel a 480x270), secondi.
(
    version: 5,
    // foglio animato 4×8 fotogrammi da 36×38 (contratto in docs/ART_BIBLE.md e presentation::player_anim)
    sprite: "sprites/summoner_sheet.png",
    // 75 px/s: attraversa lo schermo (480 px) in ~6 s, orde leggibili.
    speed: 75.0,
    // Cerchio ai piedi per le collisioni con gli ostacoli. Max 9 (varco minimo 18 px).
    footprint_radius: 5.0,
    max_hp: 100.0,
    // Dopo un colpo: niente altri danni per 0,75 s (tempo per reagire e uscire dalla calca).
    invulnerability_s: 0.75,
    // Gemme XP entro questa distanza volano verso il player.
    pickup_radius: 28.0,
    // Posti per i compagni (il primo è del compagno iniziale): angolo rispetto a "dritto
    // dietro al player", positivo verso sinistra. Gli altri si riempiono con le carte
    // "Nuovo compagno" di upgrades.ron, nell'ordine in cui vengono scelte.
    companion_slots: [
        (angle_deg: 0.0),
        (angle_deg: 55.0),
        (angle_deg: -55.0),
    ],
)
